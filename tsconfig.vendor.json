{
  // Vendor tree config (src/gateway/vendor/). Keeps the LOOSE settings G1
  // adopted for the byte-identical @musistudio/llms core, and — instead of
  // type-checking only — EMITS .d.ts declarations to dist/vendor-types so the
  // strict root program consumes vendor through declarations, never .ts source.
  // (TS expands a program along its import closure; if the root saw vendor .ts
  // it would re-check it under strict settings. Declarations are the firewall.)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM libs: the vendored @musistudio/llms core is written entirely against
    // Web/Fetch/Streams APIs (Response, ReadableStream, TextEncoder). Node 18+
    // provides these at runtime; DOM typings match how the code was authored
    // (e.g. Response.json(): Promise<any>) and — per vendor discipline —
    // resolve typecheck via tsconfig instead of editing byte-identical source.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    // Kept strict:true, but relax this one strict-family flag: upstream vendor
    // uses `catch (error) { error.message }` throughout (incl. the pristine
    // 1069-line anthropic.transformer.ts). Relaxing here avoids patching vendor
    // source for a purely-typing concern. Scoped to the vendor config only —
    // first-party code (root tsconfig) keeps strict catch.
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Emit declarations only (no JS): the strict root program reads these.
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/gateway/vendor",
    "declarationDir": "dist/vendor-types",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/gateway/vendor/llms/src/*"],
      "@vendor/*": ["src/gateway/vendor/*"],
      "@gateway/*": ["src/gateway/*"]
    }
  },
  "include": ["src/gateway/vendor"]
}
